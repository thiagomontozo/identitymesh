IDENTITYMESH_ENV=development
IDENTITYMESH_HTTP_ADDR=:8080
IDENTITYMESH_DATABASE_URL=postgres://identitymesh:identitymesh@localhost:5432/identitymesh?sslmode=disable
IDENTITYMESH_SESSION_SECRET=replace-with-at-least-32-random-bytes
IDENTITYMESH_MASTER_KEY=base64-encoded-32-byte-key
IDENTITYMESH_ALLOWED_ORIGIN=http://localhost:5173
IDENTITYMESH_SECURE_COOKIES=false
IDENTITYMESH_REQUIRE_MFA_FOR_PRIVILEGED_ROLES=false
IDENTITYMESH_MAX_CONCURRENT_SYNCS=2
IDENTITYMESH_MAX_CONCURRENT_ACTIONS=4
IDENTITYMESH_DEFAULT_SYNC_TIMEOUT=30s
IDENTITYMESH_MAX_CSV_BYTES=10485760
IDENTITYMESH_BOOTSTRAP_ADMIN_EMAIL=admin@example.test
IDENTITYMESH_BOOTSTRAP_ADMIN_PASSWORD=replace-in-local-env
IDENTITYMESH_WEBHOOK_URL=
IDENTITYMESH_WEBHOOK_SECRET=
